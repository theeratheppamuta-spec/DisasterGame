    choices:
    - "\u0E42\u0E17\u0E23\u0E28\u0E31\u0E1E\u0E17\u0E4C\u0E2B\u0E32\u0E1E\u0E48\u0E2D\u0E41\u0E21\u0E48"
    - "\u0E23\u0E35\u0E1A\u0E02\u0E36\u0E49\u0E19\u0E44\u0E1B\u0E22\u0E31\u0E07\u0E17\u0E35\u0E48\u0E2A\u0E39\u0E07"
