    choices:
    - "\u0E01\u0E25\u0E31\u0E1A\u0E44\u0E1B\u0E1A\u0E49\u0E32\u0E19\u0E17\u0E31\u0E19\u0E17\u0E35"
    - "\u0E25\u0E07\u0E44\u0E1B\u0E14\u0E39\u0E17\u0E30\u0E40\u0E25"
