  m_Script: {fileID: 11500000, guid: 3632fa8a3ba036c49924ddad673867a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UniversalCutsceneManager
  chapterID: Fire
  expectedLevelName: Fire
  chapterTextToShow: "\u0E1A\u0E17\u0E17\u0E35\u0E48 1"
  introMessages:
  - "\u0E44\u0E1F\u0E01\u0E33\u0E25\u0E31\u0E07\u0E25\u0E32\u0E21!!!"
  - "\u0E23\u0E35\u0E1A\u0E44\u0E1B\u0E2B\u0E22\u0E34\u0E1A\u0E16\u0E31\u0E07\u0E14\u0E31\u0E1A\u0E40\u0E1E\u0E25\u0E34\u0E07\u0E41\u0E25\u0E30\u0E14\u0E31\u0E1A\u0E44\u0E1F\u0E40\u0E23\u0E47\u0E27!!!
    [\u0E01\u0E14 E\u0E19\u0E30]"
  onIntroEnd:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1134823124}
        m_TargetAssemblyTypeName: FireManager, Assembly-CSharp
        m_MethodName: StartFireEvent
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 1
        m_CallState: 2
  endingMessages: []
  onEndingEnd:
    m_PersistentCalls:
      m_Calls: []
  finalMessages:
  - "\u0E2B\u0E32\u0E01\u0E44\u0E1F\u0E44\u0E2B\u0E21\u0E49\u0E43\u0E2B\u0E49\u0E43\u0E0A\u0E49\u0E16\u0E31\u0E07\u0E40\u0E1E\u0E25\u0E34\u0E07\u0E43\u0E19\u0E01\u0E32\u0E23\u0E14\u0E31\u0E1A\u0E44\u0E1F\u0E42\u0E14\u0E22
    \r\nPull - \u0E14\u0E36\u0E07 \"\u0E2A\u0E25\u0E31\u0E01\" \u0E2D\u0E2D\u0E01\r\nAim
    - \u0E40\u0E25\u0E47\u0E07\u0E44\u0E1B\u0E17\u0E35\u0E48 \"\u0E10\u0E32\u0E19\u0E02\u0E2D\u0E07\u0E44\u0E1F\"
    \r\nSqueeze - \u0E1A\u0E35\u0E1A\u0E04\u0E31\u0E19\u0E08\u0E31\u0E1A\r "
  - "Sweep - \u0E2A\u0E48\u0E32\u0E22\u0E2B\u0E31\u0E27\u0E09\u0E35\u0E14\u0E0B\u0E49\u0E32\u0E22
    - \u0E02\u0E27\u0E32\u0E42\u0E1B\u0E23\u0E14\u0E2B\u0E32\u0E1C\u0E49\u0E32\u0E2B\u0E23\u0E37\u0E2D\u0E1C\u0E49\u0E32\u0E0A\u0E38\u0E1A\u0E19\u0E49\u0E33\u0E1B\u0E34\u0E14\u0E1B\u0E32\u0E01\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E1B\u0E49\u0E2D\u0E07\u0E01\u0E31\u0E19\u0E01\u0E32\u0E23\u0E2A\u0E39\u0E14\u0E14\u0E21\u0E04\u0E27\u0E31\u0E19\r\n\u0E41\u0E25\u0E30\u0E43\u0E19\u0E01\u0E32\u0E23\u0E25\u0E07\u0E15\u0E36\u0E01\u0E04\u0E27\u0E23\u0E04\u0E25\u0E32\u0E19\u0E15\u0E48\u0E33\u0E46
    \u0E25\u0E07\u0E08\u0E32\u0E01\u0E15\u0E36\u0E01 \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E1B\u0E49\u0E2D\u0E07\u0E01\u0E31\u0E19\u0E01\u0E32\u0E23\u0E2A\u0E33\u0E25\u0E31\u0E01\u0E04\u0E27\u0E31\u0E19
    \u0E41\u0E25\u0E30\u0E2A\u0E39\u0E14\u0E04\u0E27\u0E31\u0E19\u0E40\u0E02\u0E49\u0E32\u0E44\u0E1B "
  - "\u0E44\u0E21\u0E48\u0E04\u0E27\u0E23\u0E43\u0E0A\u0E49\u0E25\u0E34\u0E1F\u0E17\u0E4C\u0E15\u0E2D\u0E19\u0E40\u0E01\u0E34\u0E14\u0E44\u0E1F\u0E44\u0E2B\u0E21\u0E49
    \u0E40\u0E1E\u0E23\u0E32\u0E30\u0E40\u0E2A\u0E35\u0E48\u0E22\u0E07\u0E15\u0E34\u0E14\u0E2D\u0E22\u0E39\u0E48\u0E43\u0E19\u0E25\u0E34\u0E1F\u0E17\u0E4C\r\n\u0E2D\u0E22\u0E48\u0E32\u0E15\u0E37\u0E48\u0E19\u0E15\u0E23\u0E30\u0E2B\u0E19\u0E01
    \u0E40\u0E1B\u0E34\u0E14\u0E1B\u0E23\u0E30\u0E15\u0E39\u0E27\u0E34\u0E48\u0E07\u0E2B\u0E19\u0E35\u0E17\u0E31\u0E19\u0E17\u0E35
    \u0E08\u0E07\u0E15\u0E31\u0E49\u0E07\u0E2A\u0E15\u0E34!!! "
  onFinalEnd:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 808003278}
